# ==============================================================================
# BEACON Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local runtime configuration.
# Do not store production secrets, API tokens, or credentials in this file.

# Application Environment: development | test | production
BEACON_ENVIRONMENT=development

# Logging Settings: DEBUG | INFO | WARNING | ERROR | CRITICAL
BEACON_LOG_LEVEL=INFO

# Logging Format: text | json
BEACON_LOG_FORMAT=text

# Storage & Directory Paths
BEACON_DATA_DIR=data
BEACON_RAW_DATA_DIR=data/raw
BEACON_SAMPLE_DATA_DIR=data/sample
